# Database (local via docker-compose)
DATABASE_URL="postgresql://jobtwin:jobtwin@localhost:5433/jobtwin"

# Redis (local via docker-compose)
REDIS_URL="redis://localhost:6380"

# Auth.js / NextAuth
AUTH_SECRET="generate-with: npx auth secret"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Required for deployed/prod hosts (and any non-localhost hostname access)
AUTH_TRUST_HOST="true"
AUTH_URL=""

# LLM provider — switch with LLM_PROVIDER ("deepseek" | "openrouter"). Defaults to "deepseek".

# DeepSeek direct API (primary)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"   # or deepseek-reasoner (R1, reasoning model)

# OpenRouter (fallback — deepseek v4 flash per spec; only needed if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-v4-flash-0731"

# Which provider is active
LLM_PROVIDER="deepseek"
# Optional override for the extraction model (defaults to the active provider's model)
# LLM_EXTRACTION_MODEL="deepseek-chat"

# Telegram notifications (pluggable notification service)
TELEGRAM_BOT_TOKEN=""
# Users link their Telegram via the bot /start flow; mapping is stored in DB.

# Sourcing agent
SOURCE_SEED_COMPANIES_JSON="[]"
AGENT_CRAWL_INTERVAL_MS="900000"
AGENT_CONCURRENCY="2"

# Playwright (optional: route downloads)
# PLAYWRIGHT_BROWSERS_PATH="/ms-playwright"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"